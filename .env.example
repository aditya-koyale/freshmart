# ─────────────────────────────────────────────────────────────
# Database
# Local dev: any PostgreSQL instance. For deployment, this is
# compatible with Neon, Supabase, or Vercel Postgres connection
# strings without code changes (decision: "Database" §3).
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freshmart?schema=public"

# ─────────────────────────────────────────────────────────────
# Authentication (NextAuth)
# Generate a secret with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ─────────────────────────────────────────────────────────────
# Initial admin seed (used only by `npm run db:seed`)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@freshmart.test"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_MOBILE="9999999999"

# ─────────────────────────────────────────────────────────────
# Cloudinary (product/banner/category image storage)
# ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────────────────────
# Google Maps (delivery address autocomplete + PIN resolution)
# GOOGLE_MAPS_API_KEY: server-side, used by src/lib/maps.ts (geocoding).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY: exposed to the browser, used by the
#   address autocomplete widget. Leave both blank to ship with manual
#   address entry only — no code changes needed either way.
# ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─────────────────────────────────────────────────────────────
# Payments — dormant in Version 1 (COD only, see SRS Part 12 §4).
# Fill these in only when online payments are activated.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
